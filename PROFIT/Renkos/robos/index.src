Parametro
  Stop(4.5);
  Take(9.0);
  Take2(8.0);
  Take3(7.0);
  Take4(3.0);
  Stop2(4.0);
  Stop3(1.0);

  LimiteProtecao(3.0);

//  Stop(1.0);
//  Take(3.0);
//  Take2(2.0);
//  Take3(1.5);
//  Take4(1.0);
//  Stop2(0.50);
//  Stop3(1.0);

  PeriodoMedia1(34);
  PeriodoMedia2(72);
  PeriodoMedia3(250);
  PeriodoToposFundos(5);
  
  MultiplicadorPavio(1.0);
  
  pAtualizarReferenciaRompimento(true);
  pModoPlot(0);
  pExibirTextoConfirmacao(false);
  
  ExibirTudo(1);
  ExibirMedias(1);
  ExibirStocastico(1);
  ExibirToposFundos(1);
  
  Habilita_3x3(1);
  Habilita_FC(1);   // Reversão
  Habilita_211(1);
  Habilita_132(1);  // Reversão
  Habilita_RC(1);   // Continuidade
  Habilita_321(1);  // Reversão
  Habilita_F2R(1);  // Continuidade
  Habilita_2211(1); // Continuidade
  Habilita_YY(1); // Continuidade
  Habilita_CXP(1); // Reversão

var
  ToposFundos, StoK, Mm1, Mm2, Mm3 : real;
  topo1, topo2, fundo1, fundo2 : real;
  UpTrend, DownTrend : boolean;

  TamanhoTijolo, TamanhoTijolo6, StopCompra, StopVenda : real;
  corAtual : integer;

  Alta0, Alta1, Alta2, Alta3, Alta4, Alta5, Alta6, Alta7, Alta8 : boolean;
  Baixa0, Baixa1, Baixa2, Baixa3, Baixa4, Baixa5, Baixa6, Baixa7, Baixa8 : boolean;

  PavioSuperior6, PavioInferior6 : real;
  TemMarteloAlta6, TemMarteloBaixa6 : boolean;
  TemPavioMaximo6 : boolean;

  PadraoCompra_3x3, PadraoVenda_3x3 : boolean;
  PadraoCompra_FC, PadraoVenda_FC : boolean;
  PadraoCompra_211, PadraoVenda_211 : boolean;
  PadraoCompra_132, PadraoVenda_132 : boolean;
  PadraoCompra_RC, PadraoVenda_RC : boolean;
  PadraoCompra_F2R, PadraoVenda_F2R : boolean;
  PadraoCompra_2211, PadraoVenda_2211 : boolean;
  PadraoCompra_YY, PadraoVenda_YY : boolean;
  PadraoCompra_CXP, PadraoVenda_CXP : boolean;  

  HabilitaStokVenda, HabilitaStokCompra : boolean;
  VerificaStocastico : boolean;
  TemRegiaoCompra, TemRegiaoVenda : boolean;
  TemEstruturaAlta, TemEstruturaBaixa : boolean;

  CondicoesCompra, CondicoesVenda : boolean;
  MostrarMedias, MostrarStocastico, MostrarToposFundos : boolean;

  PrecoEntradaLong, PrecoEntradaShort : real;
  StopAtualLong, StopAtualShort : real;
  MaiorStopLong, MaiorStopShort : real;

  iIdentUltimaBarraIdentificada : integer;
  fMaximoAtual, fMinimoAtual : float;
  fMinimoRefRomp, fMaximoRefRomp : float;
  iMaximoAtual, iMinimoAtual : integer;
  iContadorRompimentos : integer;

  fTopoFundoConfirmado : float;
  fUltimoTopoConfirmado : float;
  fUltimoFundoConfirmado : float;

begin
  StoK := SlowStochastic(21, 9, kaArithmetic);

  HabilitaStokVenda := (StoK < 85);
  HabilitaStokCompra := (StoK > 15);
  VerificaStocastico := (HabilitaStokVenda and HabilitaStokCompra);

  Mm1 := MediaExp(PeriodoMedia1, Fechamento);
  Mm2 := MediaExp(PeriodoMedia2, Fechamento);
  Mm3 := MediaExp(PeriodoMedia3, Fechamento);

  fMaximoAtual := fMaximoAtual[1];
  fMinimoAtual := fMinimoAtual[1];
  fMaximoRefRomp := fMaximoRefRomp[1];
  fMinimoRefRomp := fMinimoRefRomp[1];
  iMaximoAtual := iMaximoAtual[1];
  iMinimoAtual := iMinimoAtual[1];
  iContadorRompimentos := iContadorRompimentos[1];
  iIdentUltimaBarraIdentificada := iIdentUltimaBarraIdentificada[1];

  fTopoFundoConfirmado := fTopoFundoConfirmado[1];
  fUltimoTopoConfirmado := fUltimoTopoConfirmado[1];
  fUltimoFundoConfirmado := fUltimoFundoConfirmado[1];

  if CurrentBar = 1 then
  begin
    fMaximoAtual := High;
    fMinimoAtual := Low;
    fMaximoRefRomp := High;
    fMinimoRefRomp := Low;
    iMaximoAtual := CurrentBar;
    iMinimoAtual := CurrentBar;
    iContadorRompimentos := 0;
    iIdentUltimaBarraIdentificada := 1;
  end;

  if iIdentUltimaBarraIdentificada > 0 then
  begin
    if Low < fMinimoAtual then
    begin
      fMinimoAtual := Low;
      iMinimoAtual := CurrentBar;
      fMaximoRefRomp := High;
      iContadorRompimentos := 0;
    end;

    if pAtualizarReferenciaRompimento then
    begin
      if High > fMaximoRefRomp then
      begin
        fMaximoRefRomp := High;
        iContadorRompimentos := iContadorRompimentos + 1;
      end;
    end
    else if High > High[CurrentBar - iMinimoAtual] then
      iContadorRompimentos := iContadorRompimentos + 1;

    if (iContadorRompimentos >= PeriodoToposFundos) or (High > fMaximoAtual) then
    begin
      fTopoFundoConfirmado := fMinimoAtual;
      fUltimoFundoConfirmado := fTopoFundoConfirmado;
      Plot(fTopoFundoConfirmado);

      iIdentUltimaBarraIdentificada := -CurrentBar;
      fMaximoAtual := High;
      iMaximoAtual := CurrentBar;
      fMinimoRefRomp := Low;
      iContadorRompimentos := 0;

      if pExibirTextoConfirmacao then
        PlotText(fTopoFundoConfirmado, clGreen, -1, 9);
    end;
  end
  else
  begin
    if High > fMaximoAtual then
    begin
      fMaximoAtual := High;
      iMaximoAtual := CurrentBar;
      fMinimoRefRomp := Low;
      iContadorRompimentos := 0;
    end;

    if pAtualizarReferenciaRompimento then
    begin
      if Low < fMinimoRefRomp then
      begin
        fMinimoRefRomp := Low;
        iContadorRompimentos := iContadorRompimentos + 1;
      end;
    end
    else if Low < Low[CurrentBar - iMaximoAtual] then
      iContadorRompimentos := iContadorRompimentos + 1;

    if (iContadorRompimentos >= PeriodoToposFundos) or (Low < fMinimoAtual) then
    begin
      fTopoFundoConfirmado := fMaximoAtual;
      fUltimoTopoConfirmado := fTopoFundoConfirmado;
      Plot(fTopoFundoConfirmado);

      iIdentUltimaBarraIdentificada := CurrentBar;
      fMinimoAtual := Low;
      iMinimoAtual := CurrentBar;
      fMaximoRefRomp := High;
      iContadorRompimentos := 0;

      if pExibirTextoConfirmacao then
        PlotText(fTopoFundoConfirmado, clRed, -1, 9);
    end;
  end;

  topo1 := topo1[1];
  topo2 := topo2[1];
  fundo1 := fundo1[1];
  fundo2 := fundo2[1];

  if (fUltimoFundoConfirmado <> 0) and (fUltimoFundoConfirmado <> fundo2[1]) then
  begin
    fundo1 := fundo2;
    fundo2 := fUltimoFundoConfirmado;
  end;

  if (fUltimoTopoConfirmado <> 0) and (fUltimoTopoConfirmado <> topo2[1]) then
  begin
    topo1 := topo2;
    topo2 := fUltimoTopoConfirmado;
  end;

  TemEstruturaAlta := ((topo2 > topo1) or (fundo2 > fundo1)) and (Abertura > fundo2) and (fundo2 > fundo1);
  TemEstruturaBaixa := ((fundo2 < fundo1) or (topo2 < topo1)) and (Abertura < topo2) and (topo2 < topo1);

  MostrarMedias := (ExibirTudo = 1) or (ExibirMedias = 1);
  MostrarToposFundos := (ExibirTudo = 1) or (ExibirToposFundos = 1);

  if MostrarMedias then
  begin
    Plot2(Mm1);
    Plot3(Mm2);
    Plot4(Mm3);
  end
  else
  begin
    NoPlot(2);
    NoPlot(3);
    NoPlot(4);
  end;

  Alta0 := Fechamento > Abertura;
  Alta1 := Fechamento[1] > Abertura[1];
  Alta2 := Fechamento[2] > Abertura[2];
  Alta3 := Fechamento[3] > Abertura[3];
  Alta4 := Fechamento[4] > Abertura[4];
  Alta5 := Fechamento[5] > Abertura[5];
  Alta6 := Fechamento[6] > Abertura[6];
  Alta7 := Fechamento[7] > Abertura[7];
  Alta8 := Fechamento[8] > Abertura[8];

  Baixa0 := Fechamento < Abertura;
  Baixa1 := Fechamento[1] < Abertura[1];
  Baixa2 := Fechamento[2] < Abertura[2];
  Baixa3 := Fechamento[3] < Abertura[3];
  Baixa4 := Fechamento[4] < Abertura[4];
  Baixa5 := Fechamento[5] < Abertura[5];
  Baixa6 := Fechamento[6] < Abertura[6];
  Baixa7 := Fechamento[7] < Abertura[7];
  Baixa8 := Fechamento[8] < Abertura[8];

  TamanhoTijolo := Abs(Fechamento - Abertura);

  StopCompra := Abertura - (TamanhoTijolo * LimiteProtecao);
  StopVenda := Abertura + (TamanhoTijolo * LimiteProtecao);

  TemRegiaoCompra :=
    ((Mm1 > StopCompra) and (Fechamento > Mm1)) or
    ((Mm2 > StopCompra) and (Fechamento > Mm2)) or
    ((Mm3 > StopCompra) and (Fechamento > Mm3));

  TemRegiaoVenda :=
    ((Mm1 < StopVenda) and (Abertura < Mm1)) or
    ((Mm2 < StopVenda) and (Abertura < Mm2)) or
    ((Mm3 < StopVenda) and (Abertura < Mm3));

  CondicoesCompra := TemEstruturaAlta and TemRegiaoCompra and VerificaStocastico;
  CondicoesVenda := TemEstruturaBaixa and TemRegiaoVenda and VerificaStocastico;

  TamanhoTijolo6 := Abs(Fechamento[6] - Abertura[6]);
  PavioSuperior6 := Maxima[6] - Max(Abertura[6], Fechamento[6]);
  PavioInferior6 := Min(Abertura[6], Fechamento[6]) - Minima[6];

  TemPavioMaximo6 :=
    (PavioSuperior6 >= TamanhoTijolo6 * MultiplicadorPavio) or
    (PavioInferior6 >= TamanhoTijolo6 * MultiplicadorPavio);

  TemMarteloAlta6 := Alta6 and TemPavioMaximo6;
  TemMarteloBaixa6 := Baixa6 and TemPavioMaximo6;

  PadraoCompra_3x3 :=
    Alta0 and Baixa1 and Baixa2 and Baixa3 and
    Alta4 and Alta5 and Alta6 and Baixa7;

  PadraoVenda_3x3 :=
    Baixa0 and Alta1 and Alta2 and Alta3 and
    Baixa4 and Baixa5 and Baixa6 and Alta7;

  PadraoCompra_FC :=
    Alta0 and (Minima < Minima[1]) and Baixa1 and (Maxima[1] > Maxima[2]) and Baixa2;

  PadraoVenda_FC :=
    Baixa0 and (Maxima > Maxima[1]) and Alta1 and (Minima[1] < Minima[2]) and Alta2;

  PadraoCompra_211 :=
    Alta0 and Baixa1 and Alta2 and Alta3 and Baixa4;

  PadraoVenda_211 :=
    Baixa0 and Alta1 and Baixa2 and Baixa3 and Alta4;

  PadraoCompra_132 :=
    Alta0 and Alta1 and Baixa2 and Baixa3 and Baixa4 and Alta5 and TemMarteloAlta6;

  PadraoVenda_132 :=
    Baixa0 and Baixa1 and Alta2 and Alta3 and Alta4 and Baixa5 and TemMarteloBaixa6;

  PadraoCompra_RC :=
    (Minima < Minima[1]) and Alta0 and Alta1 and Alta2 and Baixa3;

  PadraoVenda_RC :=
    (Maxima > Maxima[1]) and Baixa0 and Baixa1 and Baixa2 and Alta3;

  PadraoCompra_F2R := Alta0 and (Minima < Abertura[2]) and (Minima[1] < Fechamento[2]) and Alta1 and Baixa2;

  PadraoVenda_F2R := Baixa0 and (Maxima > Abertura[2]) and (Maxima[1] > Fechamento[2]) and Baixa1 and Alta2;

  PadraoCompra_2211 := Alta0 and Baixa1 and Alta2 and Alta3 and Baixa4 and Baixa5 and Alta6;

  PadraoVenda_2211 := Baixa0 and Alta1 and Baixa2 and Baixa3 and Alta4 and Alta5 and Baixa6;

  PadraoCompra_YY := Alta0 and 
    (Minima < Minima[1]) and (Minima < Minima[2]) and (Minima < Minima[3]) and (Minima > Minima[4]) and 
    (Maxima[1] > Maxima) and (Maxima[1] > Maxima[2]) and
    Alta3 and Alta4 and Alta5;

  PadraoVenda_YY := 
    Baixa0 and 
    (Maxima > Maxima[1]) and (Maxima > Maxima[2]) and (Maxima > Maxima[3]) and (Maxima < Maxima[4]) and 
    (Minima[1] < Minima) and (Minima[1] < Minima[2]) and 
    Baixa3 and Baixa4 and Baixa5;

  PadraoCompra_CXP := 
    Alta0 and Alta1 and Baixa2 and Alta3 and Baixa4 and Alta5 and Alta6;

  PadraoVenda_CXP := 
    Baixa0 and Baixa1 and Alta2 and Baixa3 and Alta4 and Baixa5 and Baixa6;    
  
  if MostrarToposFundos then
  begin
    corAtual := clSilver;

    if TemEstruturaAlta then
      corAtual := clVerde
    else if TemEstruturaBaixa then
      corAtual := clVermelho
    else if TemEstruturaAlta and TemEstruturaBaixa then
      corAtual := clAmarelo; 

    PaintBar(corAtual);
  end;

  if (Habilita_3x3 = 1) and PadraoCompra_3x3 and CondicoesCompra then
    PlotText("3x3", clBlue, 0, 8);

  if (Habilita_3x3 = 1) and PadraoVenda_3x3 and CondicoesVenda then
    PlotText("3x3", clFucsia, 2, 8);

  if (Habilita_FC = 1) and PadraoCompra_FC and CondicoesCompra then
    PlotText("FC", clBlue, 0, 8);

  if (Habilita_FC = 1) and PadraoVenda_FC and CondicoesVenda then
    PlotText("FC", clFucsia, 2, 8);

  if (Habilita_211 = 1) and PadraoCompra_211 and CondicoesCompra then
    PlotText("211", clBlue, 0, 8);

  if (Habilita_211 = 1) and PadraoVenda_211 and CondicoesVenda then
    PlotText("211", clFucsia, 2, 8);

  if (Habilita_132 = 1) and PadraoCompra_132 and CondicoesCompra then
    PlotText("132", clBlue, 0, 8);

  if (Habilita_132 = 1) and PadraoVenda_132 and CondicoesVenda then
    PlotText("132", clFucsia, 2, 8);

  if (Habilita_RC = 1) and PadraoCompra_RC and CondicoesCompra then
    PlotText("RC", clBlue, 0, 8);

  if (Habilita_RC = 1) and PadraoVenda_RC and CondicoesVenda then
    PlotText("RC", clFucsia, 2, 8);

  if (Habilita_F2R = 1) and PadraoCompra_F2R and CondicoesCompra then
    PlotText("F2R", clBlue, 0, 8);

  if (Habilita_F2R = 1) and PadraoVenda_F2R and CondicoesVenda then
    PlotText("F2R", clFucsia, 2, 8);

  if (Habilita_2211 = 1) and PadraoCompra_2211 and CondicoesCompra then
    PlotText("2211", clBlue, 0, 8);

  if (Habilita_2211 = 1) and PadraoVenda_2211 and CondicoesVenda then
    PlotText("2211", clFucsia, 2, 8);

  if (Habilita_YY = 1) and PadraoCompra_YY and CondicoesCompra then
    PlotText("YY", clBlue, 0, 8);

  if (Habilita_YY = 1) and PadraoVenda_YY and CondicoesVenda then
    PlotText("YY", clFucsia, 2, 8);

  if (Habilita_CXP = 1) and PadraoCompra_CXP and CondicoesCompra then
    PlotText("CXP", clBlue, 0, 8);

  if (Habilita_CXP = 1) and PadraoVenda_CXP and CondicoesVenda then
    PlotText("CXP", clFucsia, 2, 8);

  { =========================================================
    Gerenciamento de Posições com Trailing Stop
    ========================================================= }
  
  { Mantém valores anteriores }
  PrecoEntradaLong  := PrecoEntradaLong[1];
  PrecoEntradaShort := PrecoEntradaShort[1];
  MaiorStopLong     := MaiorStopLong[1];
  MaiorStopShort    := MaiorStopShort[1];  
  
  { Gerenciamento de posição LONG }
  if (IsBought) then
  begin
    { Captura preço na entrada }
    if (IsBought[1] = false) then
    begin
      PrecoEntradaLong := Price;
      MaiorStopLong := Price - (TamanhoTijolo * Stop);  { Stop inicial }
    end; 
    
    { Define o stop com níveis progressivos }
    if (Maxima >= PrecoEntradaLong + (TamanhoTijolo * Take2)) then
      StopAtualLong := PrecoEntradaLong + (TamanhoTijolo * Stop2)
    else if (Maxima >= PrecoEntradaLong + (TamanhoTijolo * Take3)) then
      StopAtualLong := PrecoEntradaLong + (TamanhoTijolo * Stop3)
    else if (Maxima >= PrecoEntradaLong + (TamanhoTijolo * Take4)) then
      StopAtualLong := PrecoEntradaLong
    else
      StopAtualLong := Price - (TamanhoTijolo * Stop);
    
    { CRÍTICO: Stop só pode subir, nunca descer }
    if (StopAtualLong > MaiorStopLong) then
      MaiorStopLong := StopAtualLong; 
    
    SellToCoverStop(MaiorStopLong);
    SellToCoverLimit(Price + (TamanhoTijolo * Take));
  end
  
  { Gerenciamento de posição SHORT }
  else if (IsSold) then
  begin
    { Captura preço na entrada }
    if (IsSold[1] = false) then
    begin
      PrecoEntradaShort := Price;
      MaiorStopShort := Price + (TamanhoTijolo * Stop);  { Stop inicial }
    end; 
    
    { Define o stop com níveis progressivos }
    if (Minima <= PrecoEntradaShort - (TamanhoTijolo * 8)) then
      StopAtualShort := PrecoEntradaShort - (TamanhoTijolo * 4)
    else if (Minima <= PrecoEntradaShort - (TamanhoTijolo * 7)) then
      StopAtualShort := PrecoEntradaShort - (TamanhoTijolo * 1)
    else if (Minima <= PrecoEntradaShort - (TamanhoTijolo * 3)) then
      StopAtualShort := PrecoEntradaShort
    else
      StopAtualShort := Price + (TamanhoTijolo * Stop);
    
    { CRÍTICO: Stop só pode descer, nunca subir }
    if (StopAtualShort < MaiorStopShort) then
      MaiorStopShort := StopAtualShort; 
    
    BuyToCoverStop(MaiorStopShort);
    BuyToCoverLimit(Price - (TamanhoTijolo * Take));
  end; 
  
  { =========================================================
    Entradas
    ========================================================= }
  if (not IsBought) and (not IsSold) and CondicoesCompra and
    (PadraoCompra_3x3 and (Habilita_3x3 = 1) or 
    (PadraoCompra_FC and (Habilita_FC = 1)) or
    (PadraoCompra_211 and (Habilita_211 = 1)) or
    (PadraoCompra_132 and (Habilita_132 = 1)) or
    (PadraoCompra_RC and (Habilita_RC = 1)) or
    (PadraoCompra_F2R and (Habilita_F2R = 1)) or
    (PadraoCompra_2211 and (Habilita_2211 = 1)) or
    (PadraoCompra_YY and (Habilita_YY = 1)) or  
    (PadraoCompra_CXP and (Habilita_CXP = 1))) then 
      BuyAtMarket;

  if (not IsBought) and (not IsSold) and CondicoesVenda and
  (PadraoVenda_3x3 and (Habilita_3x3 = 1) or 
  (PadraoVenda_FC and (Habilita_FC = 1)) or
  (PadraoVenda_211 and (Habilita_211 = 1)) or
  (PadraoVenda_132 and (Habilita_132 = 1)) or
  (PadraoVenda_RC and (Habilita_RC = 1)) or
  (PadraoVenda_F2R and (Habilita_F2R = 1)) or
  (PadraoVenda_2211 and (Habilita_2211 = 1)) or
  (PadraoVenda_YY and (Habilita_YY = 1)) or  
  (PadraoVenda_CXP and (Habilita_CXP = 1))  
  ) then
      SellShortAtMarket; 
end;
