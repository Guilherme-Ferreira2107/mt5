{ Estratégia Renko 3x3
- Venda: 3 tijolos de alta seguidos de 3 de baixa → pinta vermelho no 6º tijolo
- Compra: 3 tijolos de baixa seguidos de 3 de alta → pinta verde no 6º tijolo
- Sem outras lógicas adicionais }
var
  Alta0,Alta1,Alta2,Alta3,Alta4,Alta5,Alta6        : boolean;
  Baixa0,Baixa1,Baixa2,Baixa3,Baixa4,Baixa5,Baixa6 : boolean;
  Pavio5,Pavio4,Pavio3                             : boolean;
  PadraoCompra,PadraoVenda                         : boolean;
begin
  { estado dos últimos 6 tijolos (0 = atual) }
  Alta0 := Fechamento > Abertura;
  Alta1 := Fechamento[1] > Abertura[1];
  Alta2 := Fechamento[2] > Abertura[2];
  Alta3 := Fechamento[3] > Abertura[3];
  Alta4 := Fechamento[4] > Abertura[4];
  Alta5 := Fechamento[5] > Abertura[5];
  Alta6 := Fechamento[6] > Abertura[6];
  Baixa0 := Fechamento < Abertura;
  Baixa1 := Fechamento[1] < Abertura[1];
  Baixa2 := Fechamento[2] < Abertura[2];
  Baixa3 := Fechamento[3] < Abertura[3];
  Baixa4 := Fechamento[4] < Abertura[4];
  Baixa5 := Fechamento[5] < Abertura[5];
  Baixa6 := Fechamento[6] < Abertura[6];
  
  { pavios: primeiro tijolo (índice 5) deve ter; segundo e terceiro (4,3) não podem }
  Pavio5 := (Maxima[5] > Max(Abertura[5],Fechamento[5])) ou (Minima[5] < Min(Abertura[5],Fechamento[5]));
  Pavio4 := (Maxima[4] > Max(Abertura[4],Fechamento[4])) ou (Minima[4] < Min(Abertura[4],Fechamento[4]));
  Pavio3 := (Maxima[3] > Max(Abertura[3],Fechamento[3])) ou (Minima[3] < Min(Abertura[3],Fechamento[3]));
  
  { 3x3 de compra: três baixas seguidas de três altas, com pavio no primeiro tijolo e sem pavio nos dois seguintes }
  PadraoCompra := Alta0 e Alta1 e Alta2 e Baixa3 e Baixa4 e Baixa5 e Pavio5;
  
  { 3x3 de venda: três altas seguidas de três baixas, com pavio no primeiro tijolo e sem pavio nos dois seguintes }
  PadraoVenda := Baixa0 e Baixa1 e Baixa2 e Alta3 e Alta4 e Alta5 e Pavio5;
  
  if PadraoCompra then
    begin
      PaintBar(clVerde);
      PlotText("3x3",clLime,2,6);
    end
  else if PadraoVenda then
    begin
      PaintBar(clVermelho);
      PlotText("3x3",clRed,2,6);
    end;
end;