Parametro
  PeriodoToposFundos(5);
  
  ExibirTudo(1);
  ExibirToposFundos(1);

var
  { --- Indicadores / zonas --- }
  ToposFundos : real;

  { --- Estrutura (topos e fundos) --- }
  topo1, topo2, fundo1, fundo2 : real;

  { --- Cores / estado --- }
  corAtual : integer;

  { --- Filtros --- }
  TemEstruturaAlta, TemEstruturaBaixa : boolean;

  { --- Condições de entrada --- }
  MostrarToposFundos : boolean;

begin
  { =========================================================
    Topos e Fundos + tendência (estrutura)
    ========================================================= }
  ToposFundos := TopBottomDetector(PeriodoToposFundos);
  //ToposFundos := TopBottomDetector(PeriodoToposFundos);
  ToposFundos := Topos_fundos_personalizado(PeriodoToposFundos,false,0,false)

  { carrega valores anteriores }
  topo1  := topo1[1];
  topo2  := topo2[1];
  fundo1 := fundo1[1];
  fundo2 := fundo2[1];

  { novo topo confirmado }
  if (ToposFundos <> 0) and (ToposFundos = Maxima) then
  begin
    topo1 := topo2;
    topo2 := ToposFundos;
  end;

  { novo fundo confirmado }
  if (ToposFundos <> 0) and (ToposFundos = Minima) then
  begin
    fundo1 := fundo2;
    fundo2 := ToposFundos;
  end;

  { tendência via topos e fundos }
  TemEstruturaAlta  := (topo2 > topo1) and (fundo2 > fundo1);
  TemEstruturaBaixa := (topo2 < topo1) and (fundo2 < fundo1);

  { controle de visualizacao }
  MostrarToposFundos := (ExibirTudo = 1) or (ExibirToposFundos = 1);

  { =========================================================
    Pintura por tendência
    ========================================================= }
  if MostrarToposFundos then
    begin
      corAtual := clSilver;

      if TemEstruturaAlta then
        corAtual := clVerde
      else if TemEstruturaBaixa then
        corAtual := clVermelho;

      PaintBar(corAtual);
    end;

end;
