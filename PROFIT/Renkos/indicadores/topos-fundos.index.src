Parametro
   Periodo(5);

var
   tf : Real;
   topo1, topo2 : Real;      { topo1 = anterior, topo2 = mais recente }
   fundo1, fundo2 : Real;    { fundo1 = anterior, fundo2 = mais recente }
   corAtual : integer;
   UpTrend, DownTrend : boolean;

Inicio

   tf := TopBottomDetector(Periodo);

   { carrega valores anteriores }
   topo2  := topo2[1];
   topo1  := topo1[1];
   fundo2 := fundo2[1];
   fundo1 := fundo1[1];

   { ao confirmar novo topo, desloca topo2 para topo1 e grava o novo em topo2 }
   if (tf <> 0) and (tf = Maxima) then
   begin
      topo1 := topo2;
      topo2 := tf;
   end;

   { ao confirmar novo fundo, desloca fundo2 para fundo1 e grava o novo em fundo2 }
   if (tf <> 0) and (tf = Minima) then
   begin
      fundo1 := fundo2;
      fundo2 := tf;
   end;

   { limpa plots ao trocar valores }
   if topo2 <> topo2[1] then NoPlot(1);
   if fundo2 <> fundo2[1] then NoPlot(2);

   { tendência de alta: topos e fundos ascendentes }
   UpTrend   := (topo2 > topo1) and (fundo2 > fundo1);
   { tendência de baixa: topos e fundos descendentes }
   DownTrend := (topo2 < topo1) and (fundo2 < fundo1);

   corAtual := clSilver;  { padrão cinza }

   if (tf <> 0) and (tf = Maxima) and UpTrend then
      corAtual := clVerde
   else if (tf <> 0) and (tf = Minima) and DownTrend then
      corAtual := clVermelho;

   PaintBar(corAtual);

   Plot(topo2);
   Plot2(fundo2);

Fim;
